MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password
SITE_ORIGIN=http://localhost:5173

# Official Google Places API (New) / Place Details Integration (Server-side only)
# Enable "Places API (New)" (and optionally "Places API") in Google Cloud Console.
# Place ID is resolved automatically from Sri Saraswathi Dental Clinic's profile,
# or can be pinned explicitly via GOOGLE_PLACE_ID.
GOOGLE_PLACES_API_KEY=none
GOOGLE_PLACE_ID=none
GOOGLE_REVIEWS_CACHE_MINUTES=360

# Official OpenAI API Integration for AI Dental Care Assistant
# Store your OpenAI API key here. Set to 'none' if using verified clinic fallback knowledge.
OPENAI_API_KEY=none
OPENAI_MODEL=gpt-4o-mini

# Google OAuth 2.0 / OpenID Connect (Client & Patient Sign-In)
# Configure an OAuth 2.0 Web Application in Google Cloud Console:
# 1. Authorized JavaScript origins:
#    - https://drkishoredentist.com
#    - https://www.drkishoredentist.com
#    - http://localhost:5173
# 2. Authorized redirect URIs:
#    - https://drkishoredentist.com/api/auth/google/callback
#    - http://localhost:5173/api/auth/google/callback
# Keep all secrets on the server-side only. Never expose GOOGLE_CLIENT_SECRET in client code.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://drkishoredentist.com/api/auth/google/callback
