MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-password
SITE_ORIGIN=http://localhost:5173

# Official Google Places API (New) / Place Details Integration (Server-side only)
# Enable "Places API (New)" (and optionally "Places API") in Google Cloud Console.
# Place ID is resolved automatically from Sri Saraswathi Dental Clinic's profile,
# or can be pinned explicitly via GOOGLE_PLACE_ID.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_CACHE_MINUTES=360
